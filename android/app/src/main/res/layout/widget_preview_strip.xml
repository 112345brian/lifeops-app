<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:background="@drawable/widget_preview_bg"
    android:orientation="horizontal">

    <!-- layout_weight=2, double every other tile's weight=1: matches
         ComboStrip's real Glance layout and WidgetConfigActivity's
         wideStrip preview, both of which render weather at double width
         (confirmed 2026-08-04, see WidgetDisplayConfig.strip()'s kdoc for
         the full "why"). This is the third of three independent renderings
         of this preset's layout (this static picker thumbnail, the Compose
         config-screen preview, and the real Glance widget); keep all three
         in sync when this preset's default content changes. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:background="@drawable/widget_preview_weather_bg"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/widget_preview_weather_temp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_preview_tile_bg"
        android:gravity="center"
        android:text="@string/widget_preview_gym"
        android:textColor="#E4E2E9"
        android:textSize="16sp" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_preview_tile_bg"
        android:gravity="center"
        android:text="@string/widget_preview_money"
        android:textColor="#E4E2E9"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
