<?xml version="1.0" encoding="utf-8"?>
<!-- Same top row as widget_preview_strip.xml (weather double-wide, then
     gym, then money), plus a second full-width row for the sample "next
     event" text: see that file's own comment on why all three independent
     renderings of this preset family (this static picker thumbnail,
     WidgetConfigActivity's Compose preview, and the real Glance widget)
     need to be kept in sync by hand. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/widget_preview_weather_bg"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/widget_preview_weather_temp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_tile_bg"
            android:gravity="center"
            android:text="@string/widget_preview_gym"
            android:textColor="#E4E2E9"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_tile_bg"
            android:gravity="center"
            android:text="@string/widget_preview_money"
            android:textColor="#E4E2E9"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_preview_tile_bg"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/widget_preview_events_title"
        android:textColor="#E4E2E9"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
