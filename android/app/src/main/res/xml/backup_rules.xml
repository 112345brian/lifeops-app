<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy (pre-Android-12) counterpart to data_extraction_rules.xml: same
     exclusions, for the old Auto Backup API that some OEM/older-OS backup
     paths still use. -->
<full-backup-content>
    <exclude domain="sharedpref" path="lifeops_widget_config.xml" />
    <exclude domain="database" path="lifeops.db" />
    <exclude domain="database" path="lifeops.db-wal" />
    <exclude domain="database" path="lifeops.db-shm" />
</full-backup-content>
